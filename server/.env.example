# Copy to server/.env and fill in. Never commit the real .env.
NODE_ENV=development
PORT=4000
# Public URL of the web client; used to build links in emails.
APP_URL=http://localhost:5173

# --- Database: Supabase Postgres (ask the team lead for the real values) ---
# Runtime connection through the transaction pooler (port 6543).
DATABASE_URL="postgresql://projectbridge_app.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&schema=public"
# Migrations through the session pooler (port 5432).
DIRECT_URL="postgresql://projectbridge_app.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?schema=public"
# Automated tests use a separate schema, so they never touch real data.
TEST_DATABASE_URL="postgresql://projectbridge_app.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?schema=projectbridge_test"

# --- Sign in with Google ---
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Must equal VITE_GOOGLE_CLIENT_ID in client/.env. Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=

# --- Password-reset email ---
# Gmail: Google Account > Security > 2-Step Verification > App passwords.
# Leave SMTP_HOST empty to use an Ethereal test inbox (emails are NOT delivered to real addresses).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=yourteam@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM="ProjectBridge <yourteam@gmail.com>"

# Security tuning
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
# Project invitations each user may send per 15 minutes.
INVITE_RATE_LIMIT=20

# --- Project screenshots and cover images (FR02): Supabase Storage ---
# Dashboard > Project Settings > API. The service_role key is server-only: never put it in client/.env.
# Leave empty to disable uploads; everything else keeps working.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Private bucket for screenshots.
MEDIA_BUCKET=project-media
# Public bucket for card cover images (every tier, Guests included, sees them).
COVER_BUCKET=project-covers
