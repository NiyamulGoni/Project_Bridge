// ProjectBridge data model (proposal Section 11.3).
// Hosted on Supabase Postgres in the `public` schema. Row Level Security is enabled with no
// policies (migration enable_rls), so Supabase's Data API cannot read these tables; only the
// Express server, connecting as the table owner, can.
// Enumerated values are stored as strings and validated in src/domain.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  /// Null for accounts that only sign in with Google.
  passwordHash String?
  googleId     String?  @unique
  /// UPLOADER | PROFESSIONAL | ADMIN. New accounts are always UPLOADER (FR01).
  role         String   @default("UPLOADER")
  /// ACTIVE | RESTRICTED | SUSPENDED | BANNED (FR16).
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions         Session[]
  emailTokens      EmailToken[]
  projects         Project[]
  memberships      ProjectMember[]
  notifications    Notification[]
  reports          Report[]
  likes            ProjectLike[]
  comments         Comment[]
  sentRequests     ContactRequest[]          @relation("RequestSender")
  receivedRequests ContactRequest[]          @relation("RequestRecipient")
  conversations    ConversationParticipant[]
  messages         Message[]
  offers           PaidOffer[]
  roleRequests     RoleRequest[]
}

/// Server-side sessions so suspension/ban invalidates access on the next request (NFR-S3).
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Single-use password-reset tokens; only the hash is stored.
model EmailToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// RESET
  type      String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  reason     String?
  /// What changed, for decisions that move a record from one value to another.
  oldValue   String?
  newValue   String?
  createdAt  DateTime @default(now())

  @@index([action, createdAt])
}

/// In-app notice for one person (DFD 8.0). Clients poll for these.
model Notification {
  id          String   @id @default(cuid())
  recipientId String
  recipient   User     @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  eventType   String
  message     String
  targetType  String?
  targetId    String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([recipientId, isRead, createdAt])
}

/// An abuse or copyright report (FR13). A report alone changes nothing about its target.
model Report {
  id           String    @id @default(cuid())
  reporterId   String
  reporter     User      @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  /// PROJECT | COMMENT | OFFER | USER | CONVERSATION
  targetType   String
  targetId     String
  /// Encrypted with lib/crypto.
  reason       String
  /// OPEN | CONFIRMED | DISMISSED
  status       String    @default("OPEN")
  decisionNote String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([status, createdAt])
  @@index([reporterId, targetType, targetId])
}

model Project {
  id                  String    @id @default(cuid())
  ownerId             String
  owner               User      @relation(fields: [ownerId], references: [id])
  title               String
  /// Short public pitch shown on cards.
  summary             String    @default("")
  problem             String    @default("")
  /// The solution/overview. Professionals see it in full; Uploaders see 500 characters (Section 4.2).
  overview            String    @default("")
  /// Lowercase tags; FR06 search requires every selected tag.
  tags                String[]  @default([])
  /// IDEA | PROTOTYPE | MVP | PILOT | LAUNCHED
  stage               String    @default("IDEA")
  /// HTTPS demonstration link (FR02).
  demoUrl             String?
  /// Owner shows the demo link and screenshots to other Uploaders (Section 4.2).
  publicDemo          Boolean   @default(false)
  thumbnailUrl        String?
  /// DRAFT | SUBMITTED | CHANGES_REQUESTED | PUBLISHED | HIDDEN | REMOVED | DELETED
  status              String    @default("DRAFT")
  /// Admin note when changes are requested.
  reviewNote          String?
  ownershipDeclaredAt DateTime?
  submittedAt         DateTime?
  publishedAt         DateTime?
  hiddenAt            DateTime?
  deletedAt           DateTime?
  /// Set when an Admin removes the project (FR14); the reason is in the audit log.
  removedAt           DateTime?
  /// Seeded demo data is labelled separately from genuine pilot projects.
  isSynthetic         Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  revisions       ProjectRevision[]
  members         ProjectMember[]
  progress        ProgressEntry[]
  milestones      Milestone[]
  media           ProjectMedia[]
  likes           ProjectLike[]
  comments        Comment[]
  contactRequests ContactRequest[]
  offers          PaidOffer[]

  @@index([status, createdAt])
  @@index([status, publishedAt])
  @@index([ownerId])
  @@index([tags], type: Gin)
}

/// A change to a published project's overview/demo awaiting Admin review (FR03).
/// The live Project row keeps the previously approved content until approval.
model ProjectRevision {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId   String
  /// Proposed snapshot of every content field; replaces the live content on approval.
  title      String
  summary    String
  problem    String
  overview   String
  tags       String[]
  demoUrl    String?
  /// PENDING | APPROVED | REJECTED
  status     String   @default("PENDING")
  reviewNote String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([projectId, status])
  @@index([status, createdAt])
}

/// Team membership (FR03). Only ACCEPTED members are credited or may edit.
model ProjectMember {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// EDITOR
  role        String   @default("EDITOR")
  /// INVITED | ACCEPTED | DECLINED
  status      String   @default("INVITED")
  invitedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([projectId, userId])
  @@index([userId, status])
}

model ProgressEntry {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId  String
  body      String
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

model Milestone {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  /// PLANNED | IN_PROGRESS | DONE
  status    String    @default("PLANNED")
  dueDate   DateTime?
  position  Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([projectId, position])
}

/// Screenshot in the private Supabase Storage bucket, served through short-lived signed URLs.
model ProjectMedia {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  storagePath String
  mimeType    String
  sizeBytes   Int
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([projectId, position])
}

/// Anonymous browsing session used to enforce the Guest card cap (FR05).
model GuestSession {
  id             String   @id @default(cuid())
  tokenHash      String   @unique
  cardsServed    Int      @default(0)
  /// Distinct projects this guest has been shown; detail views draw on the same 20-card budget.
  seenProjectIds String[] @default([])
  createdAt      DateTime @default(now())
  lastSeenAt     DateTime @updatedAt
}

/// One like per user and project (FR08); the primary key makes a double like impossible.
model ProjectLike {
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([projectId, userId])
  @@index([userId])
}

/// Plain-text comment on a published project (FR09). Only the author edits or deletes it.
model Comment {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, createdAt])
}

/// A request to start a private conversation (FR10). Sent about a project (to its owner) or to a user.
model ContactRequest {
  id           String     @id @default(cuid())
  senderId     String
  sender       User       @relation("RequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId  String
  recipient    User       @relation("RequestRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  projectId    String?
  project      Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// Set when the request answers a paid offer (FR11).
  offerId      String?
  offer        PaidOffer? @relation(fields: [offerId], references: [id], onDelete: SetNull)
  /// Encrypted with lib/crypto.
  introduction String
  /// PENDING | ACCEPTED | DECLINED | WITHDRAWN
  status       String     @default("PENDING")
  /// sender:recipient:project while PENDING, null afterwards, so only one pending request can exist.
  pendingKey   String?    @unique
  respondedAt  DateTime?
  createdAt    DateTime   @default(now())

  conversation Conversation?

  @@index([recipientId, status])
  @@index([senderId, status])
}

/// A private conversation, created once when a contact request is accepted.
model Conversation {
  id               String          @id @default(cuid())
  /// Unique, so one request can never open two conversations.
  contactRequestId String?         @unique
  contactRequest   ContactRequest? @relation(fields: [contactRequestId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime     @default(now())

  @@id([conversationId, userId])
  @@index([userId])
}

/// One private message (FR10). Only the two participants can read it.
model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  /// Encrypted with lib/crypto.
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

/// A paid contribution offer on a project (FR11). The platform processes no payments.
model PaidOffer {
  id               String   @id @default(cuid())
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId         String
  author           User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title            String
  skills           String[]
  /// FIXED | HOURLY | STIPEND | EQUITY
  type             String
  compensation     String
  currency         String
  /// How to apply: the terms a candidate needs before making contact.
  applicationRoute String
  /// OPEN | CLOSED
  status           String   @default("OPEN")
  /// PENDING | APPROVED | REJECTED
  reviewStatus     String   @default("PENDING")
  reviewNote       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  contactRequests ContactRequest[]

  @@index([projectId, reviewStatus, status])
  @@index([reviewStatus, createdAt])
}

/// An Uploader asking to become a Professional (FR15). Only an Admin decides.
model RoleRequest {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason       String
  /// PENDING | APPROVED | REJECTED
  status       String    @default("PENDING")
  /// The user id while PENDING, null afterwards, so only one pending request can exist.
  pendingKey   String?   @unique
  decisionNote String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([status, createdAt])
}
